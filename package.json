{
	"name": "sdcpp-video-frontend",
	"version": "1.0.0",
	"private": true,
	"description": "Minimal video-only web UI for stable-diffusion.cpp servers (sdcpp API).",
	"type": "module",
	"scripts": {
		"dev": "bun scripts/serve.mjs",
		"serve": "bun scripts/serve.mjs",
		"build": "bun run vendor && tsc -p tsconfig.build.json",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"vendor": "bun scripts/vendor-mediabunny.mjs",
		"postinstall": "bun run vendor"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "22.20.1",
		"mediabunny": "1.54.0",
		"typescript": "5.9.3"
	}
}
